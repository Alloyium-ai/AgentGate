{
  "version": "agentgate.poc.v2",
  "default": "deny",
  "ipv6": "deny",
  "dns": {
    "resolvers": [
      "1.1.1.1"
    ],
    "protocols": [
      "udp",
      "tcp"
    ],
    "port": 53
  },
  "web": {
    "destination": "public-ipv4",
    "rules": [
      {
        "protocol": "tcp",
        "port": 80
      },
      {
        "protocol": "tcp",
        "port": 443
      },
      {
        "protocol": "udp",
        "port": 443
      }
    ]
  },
  "taskboard": {
    "address": "10.10.10.10",
    "protocol": "tcp",
    "port": 8080,
    "task_id": 1
  },
  "filesystem": {
    "workspace": "/var/lib/agentgate/workspace",
    "scratch": [
      "/tmp"
    ],
    "read_only": [
      "/etc",
      "/proc",
      "/run/agentgate/taskboard"
    ],
    "execute": [
      "/usr",
      "/bin",
      "/sbin",
      "/lib",
      "/lib64"
    ],
    "devices": [
      "/dev/null",
      "/dev/zero",
      "/dev/random",
      "/dev/urandom"
    ],
    "deny": [
      "/etc/shadow",
      "/proc/sys",
      "/proc/kcore",
      "/proc/sysrq-trigger"
    ],
    "memory": {
      "anonymous_execute": false
    }
  },
  "process": {
    "signals": [
      "SIGINT",
      "SIGTERM",
      "SIGKILL",
      "SIGHUP",
      "SIGUSR1",
      "SIGUSR2",
      "SIGCONT",
      "SIGSTOP"
    ]
  },
  "duration_seconds": 25
}
