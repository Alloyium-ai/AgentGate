Port 2222
ListenAddress 0.0.0.0
HostKey /etc/agentgate/ssh_host_ed25519_key
AuthorizedKeysFile /etc/agentgate/authorized_keys/%u
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers agentgate-ssh
StrictModes yes
UsePAM no
PermitUserEnvironment no
PermitUserRC no
SetEnv AGENTGATE_SSH_CONFIG=/etc/agentgate/gateway.json
PermitTTY no
DisableForwarding yes
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitOpen none
GatewayPorts no
MaxSessions 1
MaxStartups 10:30:20
ClientAliveInterval 15
ClientAliveCountMax 2
PidFile /run/sshd/sshd.pid
LogLevel VERBOSE
ForceCommand /usr/local/bin/bun /opt/agentgate/agentgate_ssh_command.mts
