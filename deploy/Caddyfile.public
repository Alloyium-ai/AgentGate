# The TLS front of deploy/compose.public.yaml: Caddyfile with the public host
# name instead of localhost. HTTPS only; no plain HTTP listener or redirect.
{
  auto_https disable_redirects
  log default {
    level ERROR
    exclude http.log.error
  }
}
https://{$AGENTGATE_PUBLIC_HOST}:9443 {
  tls internal
  # The control service limits and audits by this exact client address
  # (settings trusted_proxies): replace anything a client sent.
  reverse_proxy control:8930 {
    header_up X-Forwarded-For {remote_host}
  }
}
