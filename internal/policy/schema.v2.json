              "operations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 11,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "create",
                    "bind",
                    "listen",
                    "accept",
                    "send",
                    "receive",
                    "get_local_name",
                    "get_peer_name",
                    "shutdown",
                    "set_option",
