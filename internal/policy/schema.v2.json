                  "x-value-capabilities": {
                    "create": "socket.create.v1",
                    "bind": "socket.bind.v1",
                    "listen": "socket.listen.v1",
                    "accept": "socket.accept.v1",
                    "send": "socket.send.v1",
                    "receive": "socket.receive.v1",
                    "get_local_name": "socket.get_local_name.v1",
                    "get_peer_name": "socket.get_peer_name.v1",
                    "shutdown": "socket.shutdown.v1",
                    "set_option": "socket.set_option.v1",
                    "get_option": "socket.get_option.v1"
                  }
                }
              },
              "effect": {
                "enum": [
                  "allow",
                  "deny"
