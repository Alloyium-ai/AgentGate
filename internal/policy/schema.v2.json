    "sockets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "rules"
      ],
      "properties": {
        "default": {
          "const": "deny"
        },
        "rules": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "family",
              "protocol",
              "operations",
              "effect"
