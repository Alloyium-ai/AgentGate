                "x-value-capabilities": {
                  "ipv4": "socket.ipv4.v1",
                  "ipv6": "socket.ipv6.v1",
                  "unix": "socket.unix.v1",
                  "netlink": "socket.netlink.v1",
                  "packet": "socket.packet.v1"
